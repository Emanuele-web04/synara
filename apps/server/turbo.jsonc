{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Tests import @synara/contracts from source through its ESM export and
    // create their own static fixtures, so no package build precedes them. The
    // desktop build lane validates the production web bundle separately.
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
    },
  },
}
