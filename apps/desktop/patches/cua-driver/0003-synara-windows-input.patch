diff --git a/libs/cua-driver/rust/crates/platform-windows/src/input/cancellation.rs b/libs/cua-driver/rust/crates/platform-windows/src/input/cancellation.rs
new file mode 100644
index 0000000..251e71a
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/input/cancellation.rs
@@ -0,0 +1,368 @@
+//! A native worker owns its input until matching releases have completed.
+//! The browser operation gate is shared with CDP so Stop drains both routes.
+use cua_driver_core::browser::operation_gate::{gate, OperationLease};
+use std::{
+    cell::RefCell,
+    future::Future,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+use windows::{
+    core::{Error, Result, HRESULT},
+    Win32::{
+        Foundation::{HWND, LPARAM, WPARAM},
+        UI::{
+            Controls::{HSYNTHETICPOINTERDEVICE, POINTER_TYPE_INFO},
+            Input::{KeyboardAndMouse::*, Pointer::*},
+            WindowsAndMessaging::*,
+        },
+    },
+};
+
+type Lease = Arc<OperationLease<'static>>;
+tokio::task_local! { static OPERATION: Option<Lease>; }
+thread_local! { static WORKER: RefCell<Option<Worker>> = const { RefCell::new(None) }; }
+
+pub fn spawn<F>(future: F) -> tokio::task::JoinHandle<F::Output>
+where
+    F: Future + Send + 'static,
+    F::Output: Send + 'static,
+{
+    let lease = OPERATION.try_with(Clone::clone).ok().flatten();
+    tokio::spawn(scope(lease, future))
+}
+
+pub async fn scope<F: Future>(lease: Option<Lease>, future: F) -> F::Output {
+    OPERATION.scope(lease, future).await
+}
+
+// The lease is moved into the worker, not held only by its abortable JoinHandle.
+pub fn spawn_blocking<F, R>(work: F) -> tokio::task::JoinHandle<R>
+where
+    F: FnOnce() -> R + Send + 'static,
+    R: Send + 'static,
+{
+    let lease = OPERATION.try_with(Clone::clone).ok().flatten().or_else(|| {
+        WORKER.with(|state| state.borrow().as_ref().map(|worker| worker.lease.clone()))
+    });
+    tokio::task::spawn_blocking(move || {
+        let previous = WORKER.with(|state| {
+            state.replace(lease.map(|lease| Worker {
+                lease,
+                held: Vec::new(),
+                foreground: None,
+            }))
+        });
+        struct Restore(Option<Worker>);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                let mut current = WORKER.with(|state| state.replace(self.0.take()));
+                if let Some(worker) = current.as_mut() {
+                    worker.release_all();
+                }
+                // Dropping the final lease is the completion barrier.
+            }
+        }
+        let _restore = Restore(previous);
+        work()
+    })
+}
+
+pub fn checkpoint() -> anyhow::Result<()> {
+    WORKER.with(|state| match state.borrow().as_ref() {
+        Some(worker) => {
+            gate().checkpoint(worker.lease.epoch())?;
+            if let Some((hwnd, pid, thread)) = worker.foreground {
+                let mut current_pid = 0;
+                let current_thread =
+                    unsafe { GetWindowThreadProcessId(hwnd, Some(&mut current_pid)) };
+                if current_pid != pid
+                    || current_thread != thread
+                    || unsafe { GetForegroundWindow() } != hwnd
+                {
+                    anyhow::bail!("input_target_changed: foreground window changed during input");
+                }
+            }
+            Ok(())
+        }
+        None => OPERATION
+            .try_with(|lease| match lease {
+                Some(lease) => gate().checkpoint(lease.epoch()),
+                None => Ok(()),
+            })
+            .unwrap_or(Ok(())),
+    })
+}
+/// Cosmetic waits also retain the operation lease. Stop must not wait for a
+/// cursor animation's original duration after the native input has drained.
+pub async fn until_interrupted<F: Future>(future: F) -> anyhow::Result<F::Output> {
+    tokio::pin!(future);
+    loop {
+        checkpoint()?;
+        tokio::select! {
+            result = &mut future => return Ok(result),
+            _ = tokio::time::sleep(Duration::from_millis(10)) => {},
+        }
+    }
+}
+
+fn interrupted() -> Error {
+    Error::new(HRESULT(0x800704c7u32 as i32), "Computer input interrupted")
+}
+
+/// Wake long gesture/typing delays promptly; the next actuator checks the epoch.
+/// Cleanup delays must still be allowed, so this function itself never unwinds.
+pub fn sleep(duration: Duration) {
+    let deadline = Instant::now() + duration;
+    while let Some(remaining) = deadline.checked_duration_since(Instant::now()) {
+        if checkpoint().is_err() {
+            break;
+        }
+        std::thread::sleep(remaining.min(Duration::from_millis(10)));
+    }
+}
+
+enum Release {
+    System {
+        key: (u32, u32),
+        event: INPUT,
+    },
+    Posted {
+        hwnd: HWND,
+        pid: u32,
+        thread: u32,
+        message: u32,
+        key: usize,
+        lparam: LPARAM,
+    },
+    Pointer {
+        device: HSYNTHETICPOINTERDEVICE,
+        id: u32,
+        event: POINTER_TYPE_INFO,
+    },
+}
+struct Worker {
+    lease: Lease,
+    held: Vec<Release>,
+    foreground: Option<(HWND, u32, u32)>,
+}
+
+pub struct ForegroundGuard(Option<(HWND, u32, u32)>);
+impl Drop for ForegroundGuard {
+    fn drop(&mut self) {
+        WORKER.with(|state| {
+            if let Some(worker) = state.borrow_mut().as_mut() {
+                worker.foreground = self.0;
+            }
+        });
+    }
+}
+pub fn guard_foreground(hwnd: HWND) -> ForegroundGuard {
+    let mut pid = 0;
+    let thread = unsafe { GetWindowThreadProcessId(hwnd, Some(&mut pid)) };
+    ForegroundGuard(WORKER.with(|state| {
+        state
+            .borrow_mut()
+            .as_mut()
+            .and_then(|worker| worker.foreground.replace((hwnd, pid, thread)))
+    }))
+}
+impl Worker {
+    fn release_all(&mut self) {
+        for release in self.held.drain(..).rev() {
+            let released = unsafe {
+                match release {
+                    Release::System { event, .. } => {
+                        SendInput(&[event], std::mem::size_of::<INPUT>() as i32) == 1
+                    }
+                    Release::Posted {
+                        hwnd,
+                        pid,
+                        thread,
+                        message,
+                        key,
+                        lparam,
+                    } => {
+                        let mut current_pid = 0;
+                        let current_thread = GetWindowThreadProcessId(hwnd, Some(&mut current_pid));
+                        current_pid == pid
+                            && current_thread == thread
+                            && PostMessageW(hwnd, message, WPARAM(key), lparam).is_ok()
+                    }
+                    Release::Pointer { device, event, .. } => {
+                        InjectSyntheticPointerInput(device, &[event]).is_ok()
+                    }
+                }
+            };
+            if !released {
+                gate().mark_unconfirmed_release();
+            }
+        }
+    }
+}
+
+// Track only events actually accepted by Windows. Never release unrelated keys.
+unsafe fn system_release(event: &INPUT) -> Option<((u32, u32), bool, INPUT)> {
+    let mut release = *event;
+    if event.r#type == INPUT_KEYBOARD {
+        let key = event.Anonymous.ki;
+        let up = key.dwFlags.contains(KEYEVENTF_KEYUP);
+        release.Anonymous.ki.dwFlags |= KEYEVENTF_KEYUP;
+        return Some((
+            (
+                (key.dwFlags.0 & !KEYEVENTF_KEYUP.0) << 8,
+                (u32::from(key.wVk.0) << 16) | u32::from(key.wScan),
+            ),
+            up,
+            release,
+        ));
+    }
+    if event.r#type == INPUT_MOUSE {
+        let flags = event.Anonymous.mi.dwFlags;
+        for (id, down, up) in [
+            (1, MOUSEEVENTF_LEFTDOWN, MOUSEEVENTF_LEFTUP),
+            (2, MOUSEEVENTF_RIGHTDOWN, MOUSEEVENTF_RIGHTUP),
+            (3, MOUSEEVENTF_MIDDLEDOWN, MOUSEEVENTF_MIDDLEUP),
+            (4, MOUSEEVENTF_XDOWN, MOUSEEVENTF_XUP),
+        ] {
+            if flags.contains(down) || flags.contains(up) {
+                release.Anonymous.mi.dwFlags = up;
+                return Some((
+                    (id, event.Anonymous.mi.mouseData),
+                    flags.contains(up),
+                    release,
+                ));
+            }
+        }
+    }
+    None
+}
+
+pub unsafe fn send_input(events: &[INPUT], size: i32) -> u32 {
+    if !WORKER.with(|state| state.borrow().is_some()) {
+        return SendInput(events, size);
+    }
+    let mut sent = 0;
+    for event in events {
+        let mut tagged = *event;
+        if tagged.r#type == INPUT_KEYBOARD {
+            tagged.Anonymous.ki.dwExtraInfo = super::escape_monitor::OWN_INPUT_TAG;
+        }
+        // The fallback key-up must carry the same ownership as its key-down.
+        let release = system_release(&tagged);
+        let is_up = release.as_ref().is_some_and(|(_, up, _)| *up);
+        if !is_up && checkpoint().is_err() {
+            break;
+        }
+        if SendInput(&[tagged], size) != 1 {
+            if is_up {
+                gate().mark_unconfirmed_release();
+            }
+            break;
+        }
+        sent += 1;
+        if let Some((key, up, release)) = release {
+            WORKER.with(|state| {
+                if let Some(worker) = state.borrow_mut().as_mut() {
+                    worker.held.retain(|held| !matches!(held, Release::System { key: existing, .. } if *existing == key));
+                    if !up { worker.held.push(Release::System { key, event: release }); }
+                }
+            });
+        }
+    }
+    sent
+}
+
+pub unsafe fn post_message(hwnd: HWND, message: u32, wparam: WPARAM, lparam: LPARAM) -> Result<()> {
+    let (up_message, is_up, key) = match message {
+        WM_KEYDOWN | WM_KEYUP => (WM_KEYUP, message == WM_KEYUP, wparam.0),
+        WM_SYSKEYDOWN | WM_SYSKEYUP => (WM_SYSKEYUP, message == WM_SYSKEYUP, wparam.0),
+        WM_LBUTTONDOWN | WM_LBUTTONDBLCLK | WM_LBUTTONUP => {
+            (WM_LBUTTONUP, message == WM_LBUTTONUP, 0)
+        }
+        WM_RBUTTONDOWN | WM_RBUTTONDBLCLK | WM_RBUTTONUP => {
+            (WM_RBUTTONUP, message == WM_RBUTTONUP, 0)
+        }
+        WM_MBUTTONDOWN | WM_MBUTTONDBLCLK | WM_MBUTTONUP => {
+            (WM_MBUTTONUP, message == WM_MBUTTONUP, 0)
+        }
+        _ => (0, false, 0),
+    };
+    if !is_up {
+        checkpoint().map_err(|_| interrupted())?;
+    }
+    let result = PostMessageW(hwnd, message, wparam, lparam);
+    if result.is_err() && is_up {
+        gate().mark_unconfirmed_release();
+    }
+    if result.is_ok() && up_message != 0 {
+        WORKER.with(|state| {
+            if let Some(worker) = state.borrow_mut().as_mut() {
+                worker.held.retain(|held| !matches!(held, Release::Posted { hwnd: h, message: m, key: k, .. } if *h == hwnd && *m == up_message && *k == key));
+                if !is_up {
+                    let lp = if up_message == WM_KEYUP || up_message == WM_SYSKEYUP { LPARAM(lparam.0 | (3isize << 30)) } else { lparam };
+                    let mut pid = 0;
+                    let thread = GetWindowThreadProcessId(hwnd, Some(&mut pid));
+                    worker.held.push(Release::Posted { hwnd, pid, thread, message: up_message, key, lparam: lp });
+                }
+            }
+        });
+    }
