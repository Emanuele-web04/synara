+//! Requires a disposable, interactive Windows desktop. Exercises real Win32
+//! messages and input state, not a substitute transport or a mocked injector.
+#![cfg(target_os = "windows")]
+use cua_driver_core::browser::operation_gate::gate;
+use platform_windows::input::{cancellation, keyboard, mouse};
+use std::io::{BufRead, Write};
+use std::process::{Child, Command, Stdio};
+use std::{
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        mpsc, Arc,
+    },
+    time::{Duration, Instant},
+};
+use windows::{
+    core::w,
+    Win32::{
+        Foundation::{HWND, LPARAM, WPARAM},
+        UI::{
+            Input::KeyboardAndMouse::{
+                GetAsyncKeyState, SendInput, INPUT, INPUT_0, INPUT_KEYBOARD, KEYBDINPUT,
+                KEYBD_EVENT_FLAGS, KEYEVENTF_KEYUP, VK_ESCAPE, VK_LBUTTON, VK_SHIFT,
+            },
+            WindowsAndMessaging::*,
+        },
+    },
+};
+
+struct EscapeMonitor {
+    child: Child,
+    events: mpsc::Receiver<String>,
+}
+impl EscapeMonitor {
+    fn new() -> Self {
+        let mut child =
+            Command::new(std::env::var("SYNARA_CUA_DRIVER_TEST_BINARY").expect("real driver path"))
+                .arg("--escape-monitor")
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::inherit())
+                .spawn()
+                .unwrap();
+        let (tx, events) = mpsc::channel();
+        let output = child.stdout.take().unwrap();
+        std::thread::spawn(move || {
+            for line in std::io::BufReader::new(output).lines() {
+                if tx.send(line.unwrap()).is_err() {
+                    break;
+                }
+            }
+        });
+        writeln!(child.stdin.as_mut().unwrap(), "arm").unwrap();
+        let monitor = Self { child, events };
+        assert_eq!(
+            monitor.events.recv_timeout(Duration::from_secs(5)).unwrap(),
+            r#"{"type":"ready"}"#
+        );
+        monitor
+    }
+    fn external_escape(&self) {
+        let events = [KEYBD_EVENT_FLAGS(0), KEYEVENTF_KEYUP].map(|flags| INPUT {
+            r#type: INPUT_KEYBOARD,
+            Anonymous: INPUT_0 {
+                ki: KEYBDINPUT {
+                    wVk: VK_ESCAPE,
+                    dwFlags: flags,
+                    ..Default::default()
+                },
+            },
+        });
+        assert_eq!(
+            unsafe { SendInput(&events, std::mem::size_of::<INPUT>() as i32) },
+            2
+        );
+        assert_eq!(
+            self.events.recv_timeout(Duration::from_secs(5)).unwrap(),
+            r#"{"type":"escape"}"#
+        );
+    }
+}
+impl Drop for EscapeMonitor {
+    fn drop(&mut self) {
+        self.child.stdin.take();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while self.child.try_wait().unwrap().is_none() && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        if self.child.try_wait().unwrap().is_none() {
+            let _ = self.child.kill();
+        }
+        let _ = self.child.wait();
+    }
+}
+
+struct Window {
+    hwnd: usize,
+    thread: Option<std::thread::JoinHandle<()>>,
+    escape_downs: Arc<AtomicUsize>,
+    escape_ups: Arc<AtomicUsize>,
+}
+impl Window {
+    fn new() -> Self {
+        let (tx, rx) = mpsc::channel();
+        let escape_downs = Arc::new(AtomicUsize::new(0));
+        let escape_ups = Arc::new(AtomicUsize::new(0));
+        let observed_downs = escape_downs.clone();
+        let observed_ups = escape_ups.clone();
+        let thread = std::thread::spawn(move || unsafe {
+            let hwnd = CreateWindowExW(
+                WINDOW_EX_STYLE::default(),
+                w!("EDIT"),
+                w!(""),
+                WS_OVERLAPPEDWINDOW | WS_VISIBLE | WINDOW_STYLE(ES_MULTILINE as u32),
+                100,
+                100,
+                640,
+                400,
+                None,
+                None,
+                None,
+                None,
+            )
+            .expect("create interactive EDIT fixture");
+            let _ = SetForegroundWindow(hwnd);
+            tx.send(hwnd.0 as usize).unwrap();
+            let mut message = MSG::default();
+            while GetMessageW(&mut message, None, 0, 0).as_bool() {
+                if message.message == WM_APP {
+                    break;
+                }
+                if message.wParam.0 == VK_ESCAPE.0 as usize {
+                    match message.message {
+                        WM_KEYDOWN | WM_SYSKEYDOWN => {
+                            observed_downs.fetch_add(1, Ordering::SeqCst);
+                        }
+                        WM_KEYUP | WM_SYSKEYUP => {
+                            observed_ups.fetch_add(1, Ordering::SeqCst);
+                        }
+                        _ => {}
+                    }
+                }
+                let _ = TranslateMessage(&message);
+                DispatchMessageW(&message);
+            }
+            let _ = DestroyWindow(hwnd);
+        });
+        Self {
+            hwnd: rx.recv_timeout(Duration::from_secs(10)).unwrap(),
+            thread: Some(thread),
+            escape_downs,
+            escape_ups,
+        }
+    }
+    fn text(&self) -> String {
+        let mut text = vec![0u16; self.length() + 1];
+        let length = unsafe {
+            SendMessageW(
+                HWND(self.hwnd as *mut _),
+                WM_GETTEXT,
+                WPARAM(text.len()),
+                LPARAM(text.as_mut_ptr() as isize),
+            )
+            .0 as usize
+        };
+        String::from_utf16_lossy(&text[..length])
+    }
+    fn length(&self) -> usize {
+        unsafe {
+            SendMessageW(
+                HWND(self.hwnd as *mut _),
+                WM_GETTEXTLENGTH,
+                WPARAM(0),
+                LPARAM(0),
+            )
+            .0 as usize
+        }
+    }
+}
+impl Drop for Window {
+    fn drop(&mut self) {
+        unsafe {
+            let _ = PostMessageW(HWND(self.hwnd as *mut _), WM_APP, WPARAM(0), LPARAM(0));
+        }
+        if let Some(thread) = self.thread.take() {
+            thread.join().unwrap();
+        }
+    }
+}
+async fn eventually(mut check: impl FnMut() -> bool, message: &str) {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !check() {
+        assert!(Instant::now() < deadline, "{message}");
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }
+}
+async fn start<F, R>(work: F) -> tokio::task::JoinHandle<R>
+where
+    F: FnOnce() -> R + Send + 'static,
+    R: Send + 'static,
+{
+    let lease = Arc::new(gate().admit(None).unwrap());
+    cancellation::scope(Some(lease), async { cancellation::spawn_blocking(work) }).await
+}
+async fn interrupt() -> u64 {
+    let result = tokio::task::spawn_blocking(|| gate().interrupt_and_wait(Duration::from_secs(3)))
+        .await
+        .unwrap();
+    assert_eq!(
+        result.pending, 0,
+        "acknowledgement must include native workers and releases"
+    );
+    assert!(
+        result.resumed,
+        "a verified drain must permit a fresh operation"
+    );
+    result.epoch
+}
+fn down(key: u16) -> bool {
+    unsafe { GetAsyncKeyState(key as i32) < 0 }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "mutates the disposable Windows CI desktop"]
+async fn synara_input_lifecycle() {
+    assert_eq!(
+        std::env::var("SYNARA_CUA_WINDOWS_LIVE_TEST").as_deref(),
+        Ok("1")
+    );
+    let monitor = EscapeMonitor::new();
+    let window = Window::new();
+    let hwnd = window.hwnd as u64;
+    let typing =
+        start(move || keyboard::post_type_text_with_delay(hwnd, &"x".repeat(300), 20)).await;
+    eventually(
+        || window.length() >= 3,
+        "fixture must receive real typing before interruption",
+    )
+    .await;
+    let epoch = interrupt().await;
+    assert!(typing.await.unwrap().is_err());
+    let count = window.length();
+    assert!(count < 300, "interruption must stop an in-progress action");
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert_eq!(
+        window.length(),
+        count,
+        "no late input after the drain acknowledgement"
+    );
+    assert!(
+        gate().admit(Some(epoch - 1)).is_err(),
+        "buffered pre-Escape requests must stay stale"
+    );
+
+    start(move || keyboard::send_key_synthesized(hwnd, "escape", &[]))
+        .await
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        matches!(
+            monitor.events.recv_timeout(Duration::from_millis(150)),
+            Err(mpsc::RecvTimeoutError::Timeout)
+        ),
+        "the driver's own Escape must reach the target without stopping the task"
+    );
+
+    eventually(
+        || {
+            window.escape_downs.load(Ordering::SeqCst) == 1
+                && window.escape_ups.load(Ordering::SeqCst) == 1
+        },
+        "the target must receive both halves of the driver's Escape",
+    )
+    .await;
+    // Cancel while the driver's own Escape is held: the worker's fallback
+    // release must reach this actual window, even while the hook is armed.
+    let held_escape = start(move || unsafe {
+        let event = INPUT {
+            r#type: INPUT_KEYBOARD,
+            Anonymous: INPUT_0 {
+                ki: KEYBDINPUT {
+                    wVk: VK_ESCAPE,
+                    ..Default::default()
+                },
+            },
+        };
+        assert_eq!(
+            cancellation::send_input(&[event], std::mem::size_of::<INPUT>() as i32),
+            1
+        );
+        cancellation::sleep(Duration::from_secs(5));
+    })
+    .await;
+    eventually(
+        || window.escape_downs.load(Ordering::SeqCst) == 2,
+        "held Escape did not reach the target",
+    )
+    .await;
+    interrupt().await;
+    held_escape.await.unwrap();
+    eventually(
+        || window.escape_ups.load(Ordering::SeqCst) == 2,
+        "cleanup Escape key-up did not reach the target",
+    )
+    .await;
+    assert!(!down(VK_ESCAPE.0), "cleanup left Escape held");
+
+    let modified_click =
+        start(move || mouse::send_click_synthesized_mods(hwnd, 200, 200, 100, "left", &["shift"]))
+            .await;
+    eventually(
+        || down(VK_SHIFT.0),
+        "modified click must actually hold Shift",
+    )
+    .await;
+    monitor.external_escape();
+    // Dropping a JoinHandle must not drop the worker's operation lease.
+    drop(modified_click);
+    interrupt().await;
+    eventually(
+        || !down(VK_SHIFT.0) && !down(VK_LBUTTON.0),
+        "interrupted click left a held input",
+    )
+    .await;
+
+    let changed_target_click = start(move || {
+        mouse::send_click_synthesized_active_mods(hwnd, 200, 200, 100, "left", &["shift"])
+    })
+    .await;
+    eventually(|| down(VK_SHIFT.0), "foreground click did not hold Shift").await;
+    let other_window = Window::new();
+    // Activation crosses the fixture's UI thread. GetForegroundWindow can be
+    // NULL while Windows deactivates the old window; observe the new target
+    // before asserting that the completed cleanup preserves it.
+    eventually(
+        || unsafe { GetForegroundWindow().0 as usize == other_window.hwnd },
+        "replacement fixture did not become the foreground window",
+    )
+    .await;
+    assert!(
+        changed_target_click.await.unwrap().is_err(),
+        "click continued after a foreground target change"
+    );
+    eventually(
+        || !down(VK_SHIFT.0) && !down(VK_LBUTTON.0),
+        "target change left a held input",
+    )
+    .await;
+    assert_eq!(
+        unsafe { GetForegroundWindow().0 as usize },
+        other_window.hwnd,
+        "cleanup stole the user's new foreground"
+    );
+    drop(other_window);
+
+    let drag =
+        start(move || mouse::send_drag_synthesized(hwnd, 200, 200, 400, 250, 5000, 500, "left"))
+            .await;
+    eventually(
+        || down(VK_LBUTTON.0),
+        "drag must actually hold its mouse button",
+    )
+    .await;
+    interrupt().await;
+    let _ = drag.await.unwrap();
+    eventually(
+        || !down(VK_LBUTTON.0),
+        "interrupted drag left its button down",
+    )
+    .await;
+
+    let fresh = start(move || keyboard::post_type_text(hwnd, "recovered")).await;
+    fresh.await.unwrap().unwrap();
+    eventually(
+        || window.text().contains("recovered"),
+        "fresh admitted input did not reach the window",
+    )
+    .await;
+
+    let final_drag =
+        start(move || mouse::send_drag_synthesized(hwnd, 200, 200, 400, 250, 5000, 500, "left"))
+            .await;
+    eventually(|| down(VK_LBUTTON.0), "final drag must begin before Stop").await;
+    assert_eq!(
+        tokio::task::spawn_blocking(|| gate().cancel_and_wait(Duration::from_secs(3)))
+            .await
+            .unwrap(),
+        0
+    );
+    let _ = final_drag.await.unwrap();
+    eventually(|| !down(VK_LBUTTON.0), "retirement left its button down").await;
+    assert!(
+        gate().admit(None).is_err(),
+        "retirement must never reopen this generation"
+    );
+    eprintln!("WINDOWS_NATIVE_INPUT_OK typing=interrupted modified_click=released modified_escape=observed own_escape=passed cleanup_escape=received target_change=released detached_worker=drained drag=released stale_epoch=refused fresh_input=observed stop=retired");
+}
