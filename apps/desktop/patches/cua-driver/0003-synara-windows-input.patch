+}
+
+pub unsafe fn inject_pointer(
+    device: HSYNTHETICPOINTERDEVICE,
+    events: &[POINTER_TYPE_INFO],
+) -> Result<()> {
+    for event in events {
+        let info = if event.r#type == PT_PEN {
+            event.Anonymous.penInfo.pointerInfo
+        } else {
+            event.Anonymous.touchInfo.pointerInfo
+        };
+        let up = info.pointerFlags.contains(POINTER_FLAG_UP);
+        if !up {
+            checkpoint().map_err(|_| interrupted())?;
+        }
+        let result = InjectSyntheticPointerInput(device, &[*event]);
+        if result.is_err() && up {
+            gate().mark_unconfirmed_release();
+        }
+        result?;
+        WORKER.with(|state| {
+            if let Some(worker) = state.borrow_mut().as_mut() {
+                worker.held.retain(|held| !matches!(held, Release::Pointer { device: d, id, .. } if *d == device && *id == info.pointerId));
+                if !up {
+                    let mut release = *event;
+                    if release.r#type == PT_PEN { release.Anonymous.penInfo.pointerInfo.pointerFlags = POINTER_FLAG_UP; }
+                    else { release.Anonymous.touchInfo.pointerInfo.pointerFlags = POINTER_FLAG_UP; }
+                    worker.held.push(Release::Pointer { device, id: info.pointerId, event: release });
+                }
+            }
+        });
+    }
+    Ok(())
+}
+
+pub unsafe fn destroy_pointer(device: HSYNTHETICPOINTERDEVICE) {
+    WORKER.with(|state| {
+        if let Some(worker) = state.borrow_mut().as_mut() {
+            worker.held.retain(|held| {
+                if let Release::Pointer {
+                    device: d, event, ..
+                } = held
+                {
+                    if *d == device {
+                        if InjectSyntheticPointerInput(device, &[*event]).is_err() {
+                            gate().mark_unconfirmed_release();
+                        }
+                        return false;
+                    }
+                }
+                true
+            });
+        }
+    });
+    windows::Win32::UI::Controls::DestroySyntheticPointerDevice(device);
+}
