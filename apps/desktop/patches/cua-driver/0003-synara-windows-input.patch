+++ b/libs/cua-driver/rust/crates/platform-windows/src/input/escape_monitor.rs
@@ -0,0 +1,137 @@
+//! Task-scoped Escape listener used by the desktop's existing helper transport.
+//! No text, key inventory or pointer events are retained. Unlike RegisterHotKey,
+//! a low-level hook observes Escape with any currently held modifier.
+use std::{
+    io::{BufRead, Write},
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc::{sync_channel, SyncSender},
+        OnceLock,
+    },
+};
+use windows::Win32::{
+    Foundation::{HINSTANCE, LPARAM, LRESULT, WPARAM},
+    System::{LibraryLoader::GetModuleHandleW, Threading::GetCurrentThreadId},
+    UI::{Input::KeyboardAndMouse::VK_ESCAPE, WindowsAndMessaging::*},
+};
+
+// Native input authored by this driver must reach the app, including Escape.
+// External injected events still travel through the real hook in disposable CI.
+pub const OWN_INPUT_TAG: usize = 0x53594e41;
+const ARM: u32 = WM_APP + 1;
+const DISARM: u32 = WM_APP + 2;
+static OUTPUT: OnceLock<SyncSender<&'static str>> = OnceLock::new();
+static ESCAPE_DOWN: AtomicBool = AtomicBool::new(false);
+
+fn emit(message: &'static str) {
+    if let Some(output) = OUTPUT.get() {
+        let _ = output.try_send(message);
+    }
+}
+unsafe extern "system" fn on_keyboard(code: i32, kind: WPARAM, data: LPARAM) -> LRESULT {
+    if code >= 0 {
+        let key = &*(data.0 as *const KBDLLHOOKSTRUCT);
+        if key.vkCode == u32::from(VK_ESCAPE.0) && key.dwExtraInfo != OWN_INPUT_TAG {
+            match kind.0 as u32 {
+                WM_KEYDOWN | WM_SYSKEYDOWN => {
+                    if !ESCAPE_DOWN.swap(true, Ordering::SeqCst) {
+                        emit(r#"{"type":"escape"}"#);
+                    }
+                    return LRESULT(1);
+                }
+                WM_KEYUP | WM_SYSKEYUP => {
+                    ESCAPE_DOWN.store(false, Ordering::SeqCst);
+                    return LRESULT(1);
+                }
+                _ => {}
+            }
+        }
+    }
+    CallNextHookEx(None, code, kind, data)
+}
+
+pub fn run() -> anyhow::Result<()> {
+    let (output, messages) = sync_channel::<&'static str>(32);
+    OUTPUT
+        .set(output)
+        .map_err(|_| anyhow::anyhow!("Escape monitor already started"))?;
+    std::thread::spawn(move || {
+        let stdout = std::io::stdout();
+        let mut stdout = stdout.lock();
+        for message in messages {
+            if writeln!(stdout, "{message}")
+                .and_then(|_| stdout.flush())
+                .is_err()
+            {
+                break;
+            }
+        }
+    });
+    let thread = unsafe { GetCurrentThreadId() };
+    // Create the message queue before the stdin reader can send commands.
+    unsafe {
+        let _ = PeekMessageW(&mut MSG::default(), None, 0, 0, PM_NOREMOVE);
+    }
+    std::thread::spawn(move || {
+        for command in std::io::stdin().lock().lines() {
+            let message = match command.as_deref() {
+                Ok("arm") => ARM,
+                Ok("disarm") => DISARM,
+                Ok(_) => continue,
+                Err(_) => break,
+            };
+            if unsafe { PostThreadMessageW(thread, message, WPARAM(0), LPARAM(0)) }.is_err() {
+                return;
+            }
+        }
+        unsafe {
+            let _ = PostThreadMessageW(thread, WM_QUIT, WPARAM(0), LPARAM(0));
+        }
+    });
+    let mut hook = None;
+    unsafe {
+        let mut message = MSG::default();
+        while GetMessageW(&mut message, None, 0, 0).0 > 0 {
+            match message.message {
+                ARM => {
+                    if hook.is_none() {
+                        let module = GetModuleHandleW(None)?;
+                        match SetWindowsHookExW(
+                            WH_KEYBOARD_LL,
+                            Some(on_keyboard),
+                            HINSTANCE(module.0),
+                            0,
+                        ) {
+                            Ok(installed) => {
+                                hook = Some(installed);
+                                ESCAPE_DOWN.store(false, Ordering::SeqCst);
+                            }
+                            Err(_) => {
+                                emit(
+                                    r#"{"type":"error","code":"event_tap_unavailable","message":"Windows could not install the Escape listener."}"#,
+                                );
+                                continue;
+                            }
+                        }
+                    }
+                    emit(r#"{"type":"ready"}"#);
+                }
+                DISARM => {
+                    if let Some(installed) = hook.take() {
+                        UnhookWindowsHookEx(installed)?;
+                    }
+                    ESCAPE_DOWN.store(false, Ordering::SeqCst);
+                    emit(r#"{"type":"escape-monitor-state","armed":false}"#);
+                }
+                _ => {
+                    let _ = TranslateMessage(&message);
+                    DispatchMessageW(&message);
+                }
+            }
+        }
+        if let Some(installed) = hook {
+            UnhookWindowsHookEx(installed)?;
+        }
+    }
+    Ok(())
+}
