diff --git a/libs/cua-driver/rust/crates/platform-macos/src/focus_steal.rs b/libs/cua-driver/rust/crates/platform-macos/src/focus_steal.rs
--- a/libs/cua-driver/rust/crates/platform-macos/src/focus_steal.rs
+++ b/libs/cua-driver/rust/crates/platform-macos/src/focus_steal.rs
@@ -351,6 +351,23 @@
             .collect()
     }

+    /// Human activity permanently retires the old restore destination. Merely
+    /// skipping one notification lets a later activation resurrect stale focus.
+    fn abandon(&self) {
+        self.entries.lock().unwrap().clear();
+        let _ = self.janitor_active.send(false);
+    }
+
+    fn abandon_unrelated(&self, activated_pid: i32) {
+        let mut entries = self.entries.lock().unwrap();
+        entries.retain(|_, entry| {
