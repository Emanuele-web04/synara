+    /// Every pixel at or above `threshold` alpha, as `(x, y)` pairs.
+    fn ink_with_alpha(pm: &Pixmap, threshold: u8) -> Vec<(u32, u32)> {
+        pm.pixels()
+            .iter()
+            .enumerate()
+            .filter(|(_, pixel)| pixel.alpha() >= threshold)
+            .map(|(index, _)| (index as u32 % pm.width(), index as u32 / pm.width()))
+            .collect()
+    }
