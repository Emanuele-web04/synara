+/// Whether `pid` is a running application currently hidden (Cmd+H state).
+///
+/// A hidden app's windows detach from every managed Space — WindowServer
+/// reports them with no Space membership at all — yet their AX trees stay
+/// fully reachable. This is the honest signal that distinguishes
+/// "legitimately detached while hidden" from "membership unresolved" when a
+/// window reports empty `space_ids`.
+pub(crate) fn app_is_hidden(pid: i32) -> bool {
+    use objc2_app_kit::NSRunningApplication;
+    unsafe {
+        NSRunningApplication::runningApplicationWithProcessIdentifier(pid)
+            .is_some_and(|app| app.isHidden())
+    }
+}
+
+/// Change only the target application's hidden state, through the same
+/// verified AXHidden path used by explicit visibility requests. Unlike
+/// NSRunningApplication.unhide(), this works for launch-hidden apps without
+/// reopening or activating them.
+pub(crate) fn set_app_hidden(pid: i32, hidden: bool) -> Result<Option<bool>, String> {
+    use crate::ax::bindings::{
+        copy_bool_attr, is_attribute_settable, kAXErrorSuccess, set_bool_attr,
+        AXUIElementCreateApplication, AXUIElementSetMessagingTimeout,
+    };
+    use core_foundation::base::{CFRelease, CFTypeRef};
+    use objc2_app_kit::NSRunningApplication;
+
+    unsafe {
+        let Some(app) = NSRunningApplication::runningApplicationWithProcessIdentifier(pid) else {
+            return Err(format!("pid {pid} is not a running application"));
+        };
+        // AXHidden on the application element is the cross-process hide/unhide
+        // path: NSRunningApplication.hide()/unhide() can refuse requests aimed
+        // at launch-hidden apps, while the AX attribute drives the same app
+        // hidden state the Dock's Cmd+H uses.
+        let app_element = AXUIElementCreateApplication(pid);
+        if app_element.is_null() {
+            return Err(format!(
+                "could not create an accessibility element for pid {pid}"
+            ));
+        }
+        AXUIElementSetMessagingTimeout(app_element, 2.0);
+        let result = if !is_attribute_settable(app_element, "AXHidden") {
+            Err(format!(
+                "pid {pid} does not expose a settable AXHidden attribute"
+            ))
+        } else {
+            match crate::input::cancellation::gate()
+                .post(|| set_bool_attr(app_element, "AXHidden", hidden))
+            {
+                Err(error) => Err(error.to_string()),
+                Ok(error) if error != kAXErrorSuccess => {
+                    Err(format!("AXHidden write was rejected with AXError {error}"))
+                }
+                Ok(_) => {
+                    let mut observed = None;
+                    for _ in 0..30 {
+                        if crate::input::cancellation::gate().ensure_active().is_err() {
+                            break;
+                        }
+                        std::thread::sleep(std::time::Duration::from_millis(50));
+                        if crate::input::cancellation::gate().ensure_active().is_err() {
+                            break;
+                        }
+                        let state = copy_bool_attr(app_element, "AXHidden")
+                            .unwrap_or_else(|| app.isHidden());
+                        observed = Some(state);
+                        if state == hidden {
+                            break;
+                        }
+                    }
+                    // A cancelled readback does not turn an already submitted
+                    // write into a refusal or trigger another visibility write.
+                    Ok(observed)
+                }
+            }
+        };
+        CFRelease(app_element as CFTypeRef);
