+pub(crate) fn build_dom_text_index(snapshot: &Value) -> Vec<DomTextRun> {
+    let Some(strings) = snapshot.get("strings").and_then(Value::as_array) else {
+        return Vec::new();
+    };
+    let string_at = |idx: i64| -> Option<String> {
+        usize::try_from(idx)
+            .ok()
+            .and_then(|idx| strings.get(idx))
+            .and_then(Value::as_str)
+            .map(str::to_owned)
+    };
+
+    let mut runs = Vec::new();
+    let Some(documents) = snapshot.get("documents").and_then(Value::as_array) else {
+        return runs;
+    };
+    for document in documents {
+        let frame_id = document
+            .get("frameId")
+            .and_then(Value::as_str)
+            .map(str::to_owned);
+        let Some(nodes) = document.get("nodes") else {
+            continue;
+        };
+        let array = |field: &str| {
+            nodes
+                .get(field)
+                .and_then(Value::as_array)
+                .cloned()
+                .unwrap_or_default()
+        };
+        let node_types = array("nodeType");
+        let node_values = array("nodeValue");
+        let parent_indices = array("parentIndex");
+        let backend_ids = array("backendNodeId");
+
+        // Layout entries keyed by the index into the document's node list.
+        let mut laid_out: HashMap<usize, Rect> = HashMap::new();
+        if let Some(layout) = document.get("layout") {
+            let indices = layout
+                .get("nodeIndex")
+                .and_then(Value::as_array)
+                .cloned()
+                .unwrap_or_default();
+            let bounds = layout
+                .get("bounds")
+                .and_then(Value::as_array)
+                .cloned()
+                .unwrap_or_default();
+            for (position, node_index) in indices.iter().enumerate() {
+                let Some(node_index) = node_index
+                    .as_u64()
+                    .and_then(|value| usize::try_from(value).ok())
+                else {
+                    continue;
+                };
+                if let Some(rect) = bounds.get(position).and_then(Rect::from_value) {
+                    laid_out.insert(node_index, rect);
+                }
+            }
+        }
+
+        let backend_at = |index: usize| -> Option<i64> {
+            backend_ids
+                .get(index)
+                .and_then(Value::as_i64)
+                .filter(|value| *value > 0)
+        };
+        let parent_at = |index: usize| -> Option<usize> {
+            parent_indices
+                .get(index)
+                .and_then(Value::as_i64)
+                .and_then(|value| usize::try_from(value).ok())
+                .filter(|value| *value < node_types.len())
+        };
+
+        for index in 0..node_types.len() {
+            if node_types.get(index).and_then(Value::as_i64) != Some(3) {
+                continue;
+            }
+            let Some(value_index) = node_values.get(index).and_then(Value::as_i64) else {
+                continue;
+            };
+            let Some(text) = string_at(value_index) else {
+                continue;
+            };
+            let Some(backend_node_id) = backend_at(index) else {
+                continue;
+            };
+
+            // Nearest laid-out ancestor carries the text's visible box; a
+            // text node's own layout entry is used when Chrome emits one.
+            // The walk is bounded: a malformed endpoint must not be able to
+            // loop the collector through a cyclic parent chain.
+            let mut rect = laid_out.get(&index).copied();
+            let mut parent_backend_node_id = None;
+            let mut parent = parent_at(index);
+            let mut hops = 0;
+            while let Some(parent_index) = parent {
+                if hops >= MAX_DOM_TEXT_ANCESTOR_HOPS {
+                    break;
+                }
+                hops += 1;
+                if parent_backend_node_id.is_none() {
+                    parent_backend_node_id = backend_at(parent_index);
+                }
+                if rect.is_none() {
+                    rect = laid_out.get(&parent_index).copied();
+                }
+                parent = parent_at(parent_index);
+            }
+
+            runs.push(DomTextRun {
+                backend_node_id,
+                parent_backend_node_id,
+                text,
+                order: index,
+                rect,
+                frame_id: frame_id.clone(),
+            });
+        }
+    }
+    runs
+}
