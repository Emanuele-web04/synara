+        let completed = gate.interrupt_and_wait(Duration::ZERO);
+        assert_eq!(completed.pending, 0);
+        assert!(completed.resumed);
+        assert!(gate.lease_with_target(None, old_epoch).is_err());
+        assert!(gate.lease().is_ok());
