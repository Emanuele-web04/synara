+    fn input_readiness_context(
+        mode: PermissionMode,
+        manifest_yaml: Option<&str>,
+    ) -> std::sync::Arc<crate::session_authorization::EffectiveAuthorizationContext> {
+        use std::io::Write as _;
+        let manifest = manifest_yaml.map(|yaml| {
+            let mut file = tempfile::NamedTempFile::new().unwrap();
+            file.write_all(yaml.as_bytes()).unwrap();
+            std::sync::Arc::new(crate::session_manifest::load_manifest(file.path()).unwrap())
+        });
+        let ceiling = crate::session_authorization::SessionModeCeiling::for_trusted_sessions(
+            [
+                PermissionMode::Standard,
+                PermissionMode::Bounded,
+                PermissionMode::Unrestricted,
+            ],
+            true,
+            std::time::Duration::from_secs(60),
+            std::time::Duration::from_secs(30),
+        )
+        .unwrap();
+        crate::session_authorization::SessionAuthorizationRegistry::with_ceiling(ceiling)
+            .compatibility_context(mode, manifest)
+            .unwrap()
+    }
