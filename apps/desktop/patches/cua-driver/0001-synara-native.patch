+        start: f64,
+        target: f64,
+        spec: SpringSpec,
+        steps: usize,
+        dt: f64,
+    ) -> SpringChannel {
+        let mut channel = SpringChannel::new(start);
+        for _ in 0..steps {
+            channel.step(target, &spec, dt);
+        }
