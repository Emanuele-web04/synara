+
+    #[test]
+    fn retarget_chains_from_the_currently_painted_point() {
+        let mut m = motion((0.0, 0.0), (600.0, 0.0));
+        for _ in 0..20 {
+            m.tick(1.0 / 120.0, &feel(), false, CompactActivity::Idle);
+        }
