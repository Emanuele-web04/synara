+        );
+        actual = window();
+        actual.current_space_id = Some(10);
+        assert_eq!(
+            target.verify_snapshot(Some(&actual), 4).unwrap_err().code,
+            "target_not_on_active_space"
+        );
+    }
+    #[test]
+    fn malformed_bounds_and_ambiguous_identity_fail_closed() {
+        for args in [
+            json!({"pid":42}),
+            json!({"pid":-1,"window_id":7}),
+            json!({"pid":42,"window_id":0}),
+        ] {
+            assert_eq!(InputTarget::parse(&args).unwrap_err().code, "stale_target");
+        }
+        let args = json!({"pid":42,"window_id":7,"expected_window_bounds":{"x":0,"y":0,"width":0,"height":50}});
+        assert_eq!(
+            InputTarget::parse(&args).unwrap_err().code,
+            "stale_geometry"
+        );
+        let refused = target().verify_snapshot(None, 4).unwrap_err().tool_result();
+        let value = serde_json::to_value(refused).unwrap();
+        assert_eq!(value["structuredContent"]["effect"], "refused");
+        assert_eq!(value["structuredContent"]["ready"], false);
+    }
+    #[test]
+    fn focused_sheet_before_its_window_refuses_with_auth_sheet_focused() {
+        let refusal =
+            focused_sheet_refusal(42, 7, &["AXTextField", "AXSheet", "AXWindow"]).unwrap();
+        assert_eq!(refusal.code, "auth_sheet_focused");
+        let value = serde_json::to_value(refusal.tool_result()).unwrap();
+        assert_eq!(value["structuredContent"]["effect"], "refused");
+        assert_eq!(value["structuredContent"]["code"], "auth_sheet_focused");
+        assert_eq!(value["structuredContent"]["ready"], false);
+        assert!(value["structuredContent"]["reason"]
+            .as_str()
+            .unwrap()
+            .contains("nothing was sent"));
+    }
+    #[test]
+    fn focus_without_a_sheet_never_refuses() {
+        assert!(focused_sheet_refusal(42, 7, &[]).is_none());
+        assert!(focused_sheet_refusal(42, 7, &["AXButton", "AXWindow"]).is_none());
+        assert!(
+            focused_sheet_refusal(42, 7, &["AXTextField", "AXWindow", "AXApplication"]).is_none()
+        );
+        // A sheet beyond the enclosing window is not the focus chain.
+        assert!(focused_sheet_refusal(42, 7, &["AXTextField", "AXWindow", "AXSheet"]).is_none());
+    }
+}
