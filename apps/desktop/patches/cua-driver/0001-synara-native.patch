+    }
+
+    #[test]
+    fn paused_freezes_every_channel_and_holds_the_frame() {
+        let mut m = motion((0.0, 0.0), (1200.0, 0.0));
+        for _ in 0..10 {
+            m.tick(1.0 / 120.0, &feel(), false, CompactActivity::Idle);
+        }
+        let frozen = m.channels(&feel(), CompactActivity::Idle);
+        for _ in 0..120 {
