+/// Bounded focus proof used only by background-click restoration. `Ok(None)`
+/// is an explicit AXNoValue (a lost key window); timeout, malformed values and
+/// unreadable window identity are `Err`, never permission to restore focus.
+pub(crate) fn focused_window_id_for_restore(
+    pid: i32,
+    deadline: std::time::Instant,
+) -> Result<Option<u32>, ()> {
+    struct OwnedValue(CFTypeRef);
+    impl Drop for OwnedValue {
+        fn drop(&mut self) {
+            if !self.0.is_null() {
+                unsafe { CFRelease(self.0) };
+            }
+        }
+    }
+    unsafe fn set_timeout(
+        element: AXUIElementRef,
+        deadline: std::time::Instant,
+    ) -> Result<std::time::Instant, ()> {
+        let start = std::time::Instant::now();
+        let remaining = deadline.saturating_duration_since(start);
+        let timeout = crate::input::focus_restore_policy::bounded_ax_timeout(remaining).ok_or(())?;
+        let read_deadline = deadline.min(start + std::time::Duration::from_millis(25));
+        if AXUIElementSetMessagingTimeout(element, timeout) == kAXErrorSuccess
+            && std::time::Instant::now() < read_deadline
+        {
+            Ok(read_deadline)
+        } else {
+            Err(())
+        }
+    }
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return Err(());
+        }
+        let _app = OwnedValue(app as CFTypeRef);
+        let read_deadline = set_timeout(app, deadline)?;
+        let attr = CFStr::new("AXFocusedWindow");
+        let mut value: CFTypeRef = std::ptr::null();
+        let error = AXUIElementCopyAttributeValue(app, attr.as_concrete_TypeRef(), &mut value);
+        let _window = OwnedValue(value);
+        if std::time::Instant::now() >= read_deadline {
+            return Err(());
+        }
+        if error == kAXErrorNoValue {
+            return Ok(None);
+        }
+        if error != kAXErrorSuccess
+            || value.is_null()
+            || core_foundation::base::CFGetTypeID(value) != AXUIElementGetTypeID()
+        {
+            return Err(());
+        }
+        let window = value as AXUIElementRef;
+        // Returned elements do not necessarily inherit their app's timeout.
+        let read_deadline = set_timeout(window, deadline)?;
+        let window_id = ax_get_window_id(window).ok_or(())?;
+        if std::time::Instant::now() >= read_deadline {
+            return Err(());
+        }
+        Ok(Some(window_id))
+    }
+}
