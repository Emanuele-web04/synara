+/// Compose DOM text runs the accessibility tree did not expose. Runs whose
+/// exact text already exists as an accessible name are skipped, so the digest
+/// stays honest and does not restate outline names.
+fn supplement_dom_text(
+    nodes: &mut Vec<SemanticNode>,
+    texts: &[DomTextRun],
+    viewport: &Viewport,
+    frame: &FrameRef,
+) {
+    let existing_names = nodes
+        .iter()
+        .filter_map(|node| node.name.clone())
+        .collect::<HashSet<_>>();
+    let expected_frame = frame
+        .identity
+        .as_ref()
+        .map(|identity| identity.frame_id.as_str());
+    let mut added = 0usize;
+    for run in texts {
+        if added >= MAX_DOM_TEXT_NODES_PER_FRAME {
+            break;
+        }
+        if expected_frame.is_some() && run.frame_id.as_deref() != expected_frame {
+            continue;
+        }
+        let Some(text) = clean_semantic_text(run.text.clone()) else {
+            continue;
+        };
+        if !has_text_content(&text) || existing_names.contains(&text) {
+            continue;
+        }
+        let Some(rect) = run.rect else {
+            continue;
+        };
+        let visibility = classify_rect_visibility(rect, viewport);
+        if !matches!(
+            visibility,
+            BrowserVisibility::InViewport | BrowserVisibility::NearViewport
+        ) {
+            continue;
+        }
+        let parent_ax_id = run.parent_backend_node_id.and_then(|parent| {
+            nodes
+                .iter()
+                .find(|node| node.backend_node_id == Some(parent))
+                .map(|node| node.ax_id.clone())
+        });
+        nodes.push(SemanticNode {
+            ax_id: format!("domtext-{}", run.backend_node_id),
+            parent_ax_id,
+            child_ax_ids: Vec::new(),
+            backend_node_id: Some(run.backend_node_id),
+            role: "text".to_owned(),
+            name: Some(text),
+            value: None,
+            states: BTreeMap::new(),
+            frame: frame.clone(),
+            visibility,
+            actions: Vec::new(),
+            document_order: run.order,
+        });
+        added += 1;
+    }
+}
