+        for _ in 0..60 {
+            m.tick(1.0 / 120.0, &feel(), true, CompactActivity::Idle);
+        }
+        let pressed = m.channels(&feel(), CompactActivity::Idle).scale;
+        assert!(pressed < 0.92, "pressed scale must shrink, got {pressed}");
+        for _ in 0..600 {
