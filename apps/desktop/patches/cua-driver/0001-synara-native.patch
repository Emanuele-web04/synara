+/// Second embedded liveness channel, independent of the stdin pipe: the host
+/// records its pid in `CUA_DRIVER_EMBEDDED_HOST_PID`, so `kill(pid, 0)`
+/// answers "is the host gone" directly. Stdin EOF is the fast path, but a
+/// leaked duplicate of the lifetime fd can hold the channel open past host
+/// death — the pid check cannot be defeated that way. Resolves only when the
+/// host is gone; pends forever when no host pid was recorded (non-embedded
+/// daemons keep their own lifetime rules).
+async fn wait_for_embedded_host_death() {
+    #[cfg(unix)]
+    {
+        let host_pid = std::env::var("CUA_DRIVER_EMBEDDED_HOST_PID")
+            .ok()
+            .and_then(|raw| raw.parse::<libc::pid_t>().ok())
+            .filter(|pid| *pid > 0);
+        let Some(pid) = host_pid else {
+            return std::future::pending::<()>().await;
+        };
+        loop {
+            // kill(pid, 0): 0 = alive, EPERM = alive-but-foreign, ESRCH = gone.
+            let alive = unsafe {
+                libc::kill(pid, 0) == 0
+                    || std::io::Error::last_os_error().raw_os_error() == Some(libc::EPERM)
+            };
+            if !alive {
+                eprintln!("Cua Driver embedded host pid {pid} is gone; shutting down.");
+                return;
+            }
+            tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+        }
+    }
+    #[cfg(not(unix))]
+    std::future::pending::<()>().await;
+}
