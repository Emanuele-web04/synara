+    #[test]
+    fn target_invalidation_stops_new_events_but_releases_and_next_action_survive() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        let gate = InputGate::default();
+        let downs = AtomicUsize::new(0);
+        let ups = AtomicUsize::new(0);
