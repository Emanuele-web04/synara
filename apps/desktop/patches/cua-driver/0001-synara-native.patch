+static STYLE_DEF: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+
+/// Internal/control tool: callable by an embedding host over the daemon
+/// socket, deliberately absent from the model-facing `tools/list` (see
+/// `cua_driver_core::tool::is_internal_control_tool`). The contract is not
+/// part of the public SDK manifest, so it cannot drift into a model prompt.
+fn style_def() -> &'static ToolDef {
+    STYLE_DEF.get_or_init(|| ToolDef {
+        name: "set_agent_cursor_style".into(),
+        description: "Set the session cursor's color channels (fill, rim, shadow). \
+                      Omitted channels keep the stock monochrome pointer (near-black fill, \
+                      light rim, soft black shadow). Hex \"#rrggbb\" only; invalid values are \
+                      rejected. Session-scoped exactly like set_agent_cursor_motion."
+            .into(),
+        input_schema: serde_json::json!({
+            "type": "object",
+            "properties": {
+                "session": {
+                    "type": "string",
+                    "description": "Session label whose cursor is restyled; omit to use the caller's implicit session."
+                },
+                "fill": {
+                    "type": "string",
+                    "description": "Arrow body color, \"#rrggbb\". Omit for the stock near-black."
+                },
+                "rim": {
+                    "type": "string",
+                    "description": "Outline color, \"#rrggbb\". Omit for the stock light rim."
+                },
+                "shadow": {
+                    "type": "string",
+                    "description": "Drop-shadow color, \"#rrggbb\". Omit for the stock black."
+                }
+            },
+            "additionalProperties": false
+        }),
+        read_only: false,
+        destructive: false,
+        idempotent: true,
+        open_world: false,
+    })
+}
+
+fn parse_style_arg(args: &Value, channel: &str) -> Result<Option<[u8; 3]>, String> {
+    match args.get(channel) {
+        None | Some(Value::Null) => Ok(None),
+        Some(Value::String(value)) => cursor_overlay::parse_style_color(channel, value).map(Some),
+        Some(other) => Err(format!(
+            "cursor style `{channel}` must be a \"#rrggbb\" string, got {other}"
+        )),
+    }
+}
+
+#[async_trait]
+impl Tool for SetAgentCursorStyleTool {
+    fn def(&self) -> &ToolDef {
+        style_def()
+    }
+
+    async fn invoke(&self, args: Value) -> ToolResult {
+        if !self.state.cursor_overlay_available {
+            return super::cursor_overlay_unavailable();
+        }
+        let session = resolve_cursor_key(&args);
+        let mut style = cursor_overlay::CursorStyle::default();
+        for (channel, slot) in [
+            ("fill", &mut style.fill),
+            ("rim", &mut style.rim),
+            ("shadow", &mut style.shadow),
+        ] {
+            match parse_style_arg(&args, channel) {
+                Ok(value) => *slot = value,
+                Err(error) => return ToolResult::error(error),
+            }
+        }
+        let mut state = self.state.cursor_registry.get_or_create(&session);
+        state.config.style = style;
+        self.state.cursor_registry.update_config(state.config);
+        crate::cursor::overlay::send_command(
+            session.clone(),
+            cursor_overlay::OverlayCommand::SetStyle(style),
+        );
+        ToolResult::text(format!(
+            "Agent cursor style for session '{session}' updated{}.",
+            if style.is_stock() {
+                " (stock monochrome)"
+            } else {
+                ""
+            }
+        ))
+        .with_structured(serde_json::json!({
+            "session": session,
+            "style": {
+                "stock": style.is_stock(),
+                "fill": style.fill.map(hex_string),
+                "rim": style.rim.map(hex_string),
+                "shadow": style.shadow.map(hex_string)
+            }
+        }))
+    }
+}
+
+fn hex_string(rgb: [u8; 3]) -> String {
+    format!("#{:02x}{:02x}{:02x}", rgb[0], rgb[1], rgb[2])
+}
