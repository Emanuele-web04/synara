# Postgres connection string used by Drizzle (server-side only).
# Hosted MVP: Supabase PostgreSQL; login remains WorkOS, not Supabase Auth.
# Copy Direct or Session pooler (:5432) from Connect; add sslmode=verify-full
# and sslrootcert=/absolute/path/to/project-ca.crt if that CA is required.
# Disable the dedicated project's Data API; see README's Supabase section.
# No SUPABASE_URL/anon/service-role API key is needed by this service.
# Local development below matches docker-compose.yml (postgres:18).
DATABASE_URL=postgres://synara:synara@localhost:5432/synara_accounts

# Which identity provider backs the adapter seam. Unset or "workos" (the
# default) is the real provider; "dev" is the offline development provider —
# it prints OTP codes to stdout and REFUSES to start with NODE_ENV=production
# or while WORKOS_API_KEY is set. Never set "dev" in a deployment.
# IDENTITY_PROVIDER=

# --- WorkOS AuthKit ---
# Identity lives in WorkOS: this service stores no passwords and no user rows.
# Both values come from the WorkOS dashboard.

# Secret API key (starts with sk_). Server-side only — never ship it to a client.
WORKOS_API_KEY=

# Client id for the AuthKit application (starts with client_).
WORKOS_CLIENT_ID=

# Public base URL of this account service.
ACCOUNT_BASE_URL=http://localhost:8788

# Exact public API issuer/origin used in host/device JWT audiences and iss.
API_PUBLIC_URL=http://localhost:8788/api/v1

# Base64url-encoded 32-byte Ed25519 seed for host grants and JWKS.
# Required with WorkOS. Dev mode generates an ephemeral key and warns if unset.
API_SIGNING_KEY=

# --- Polar / Synara Pro Remote subscriptions (optional; OFF by default) ---
# Keep each environment's token, webhook secret and IDs in its protected
# operator-managed file outside the checkout. Never add secrets to a client,
# log or Git. Sandbox and production need separate organizations AND databases;
# the durable billing_environment stamp refuses cross-environment reuse.
# POLAR_BILLING_ENABLED=false
# POLAR_ENVIRONMENT=sandbox
# Production additionally requires this explicit interlock (default false):
# POLAR_PRODUCTION_PAYMENTS_ENABLED=false
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ORGANIZATION_ID=
# POLAR_MONTHLY_PRODUCT_ID=
# POLAR_YEARLY_PRODUCT_ID=
# POLAR_DESKTOP_BENEFIT_ID=
# Required complete catalog expectations in production; optional complete set
# in sandbox. Prices must explicitly use exclusive tax behavior.
# POLAR_EXPECTED_CURRENCY=USD
# POLAR_EXPECTED_MONTHLY_AMOUNT_MINOR=799
# POLAR_EXPECTED_YEARLY_AMOUNT_MINOR=8499
# POLAR_EXPECTED_TAX_BEHAVIOR=exclusive
# Production: nonempty CSV of exact operator-controlled HTTPS origins without
# credentials, non-default ports, paths, queries or fragments. Both return URLs
# must use one of these origins. No particular hostname is required.
# POLAR_RETURN_ORIGINS=
# HTTP loopback return URLs below are sandbox-only:
# POLAR_CHECKOUT_SUCCESS_URL=http://localhost:8788/
# POLAR_PORTAL_RETURN_URL=http://localhost:8788/
# Separate remote-only Pro enforcement; false preserves the current rollout.
# True requires configured Polar billing and never replaces ownership checks.
# POLAR_REMOTE_ACCESS_ENFORCED=false
# This covers ALL official Remote ingress (including LAN/SSH, HTTP/files,
# WebSocket sessions and frames). Positive local desktop use remains free.
# Account/history/export and revocation/cleanup are not a subscription gate.
#
# Execution-host settings below belong in that host's OWN launch config,
# not this account API process. No runtime values are changed by this example.
# Use the canonical account API origin of the actual Remote deployment;
# do not copy a trial URL or assume the UI's generic fallback is the authority.
# SYNARA_ACCOUNT_URL=
# Keep false NOW; true is required only at the approved MANUAL paid rollout:
# SYNARA_REMOTE_BILLING_POLICY_REQUIRED=false
# The host's no-store public policy hint is authority-scoped and survives
# logout/unlink. In strict mode unknown/outage holds Remote closed, a verified
# OFF proof lasts at most 60s, and only positive PAID leases get outage grace.
# None of this turns an IP/role/legacy cookie into positive local proof.
# Desktop panel visibility only; the server selects the environment.
# VITE_SYNARA_BILLING_ENABLED=1
# Legacy visibility alias retained for existing isolated builds:
# VITE_SYNARA_BILLING_SANDBOX=1
# Monthly-only public campaign code is configured in Polar, not a client env:
# percentage 50%, duration once, monthly product only, one redemption/customer.
# No campaign is provisioned by this example; annual checkouts disallow codes.

# Previous signing seed kept in JWKS during a key rotation. Verification-only.
# API_SIGNING_KEY_PREVIOUS=

# --- Managed Cloudflare remote access (optional as a complete set) ---
# Administrative token stays on this API only. Needs account tunnel write and
# zone DNS write. Use a dedicated test zone; see docs/cloudflare-remote.md.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_TUNNEL_DOMAIN=

# Remote rollout while POLAR_REMOTE_ACCESS_ENFORCED=false: explicitly allow
# signed-in accounts on this deployment, or only the WorkOS test-user IDs.
# Both unset/false and an empty list deny remote enrollment. When paid
# enforcement is true, neither setting bypasses the commercial access check;
# host ownership, organization membership and device approval always apply.
# REMOTE_BETA_ACCESS_ENABLED=false
# REMOTE_TEST_USER_IDS=

# Port the HTTP server listens on. Defaults to 8788 if unset.
PORT=8788

# How many proxies in front of this service append to x-forwarded-for.
# Defaults to 0: trust only the socket address — the safe value for a
# direct/Docker self-host, where any caller can send the header and a
# trusted hop would let them rotate forged IPs past every per-IP rate
# budget. Behind a TLS-terminating proxy the socket is the proxy, so set
# the hop count explicitly: Railway (and similar single-proxy platforms)
# need TRUSTED_PROXY_HOPS=1.
# TRUSTED_PROXY_HOPS=1

# Shared secret authenticating the profiles SSR deployment (apps/profiles)
# to this API. When set, a GET /profiles/:handle request carrying a matching
# x-synara-proxy-secret header has its rate limit keyed on the
# x-synara-viewer-ip header it forwards — per-visitor budgets instead of one
# shared bucket for the SSR egress IP. Rate-limit keying only, never
# authentication. Unset, the viewer header is ignored entirely.
# PROFILE_PROXY_SECRET=

# ActivityKit: configure all five together; keep real keys out of Git.
# APNS_PRIVATE_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_ENVIRONMENT=sandbox
# Optional Production-only signer when the default key is Sandbox-restricted.
# APNS_PRODUCTION_PRIVATE_KEY=
# APNS_PRODUCTION_KEY_ID=

# --- Avatar storage (S3-compatible, optional) ---
# Where uploaded profile avatars live: any S3-compatible object store —
# Cloudflare R2, MinIO, AWS S3, … — addressed path-style through S3_ENDPOINT.
# All five variables are optional AS A SET: leave them all unset to run
# without avatar uploads (the upload routes answer 503, nothing else is
# affected). A partial set refuses to start, so a typo cannot silently
# disable uploads in production.

# S3 API endpoint origin, e.g. https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT=

# Bucket the avatars are written to.
# S3_BUCKET=

# Access key pair for the bucket. Server-side only.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Public origin the bucket is served from (CDN or custom domain, no trailing
# slash); avatar URLs are ${S3_PUBLIC_BASE_URL}/${object key}.
# S3_PUBLIC_BASE_URL=

# SigV4 signing region. Optional — defaults to "auto", the spelling R2
# requires and MinIO accepts. Real AWS S3 rejects "auto": set the bucket's
# actual region (e.g. us-east-1) there.
# S3_REGION=

# --- WorkOS overrides ---
# Only needed to point at something other than the real WorkOS API; the test
# suite sets these to an in-process stand-in. Leave unset in production.
#
# The expected issuer and the JWKS URL are NOT configured here by default: both
# are read from WorkOS's OIDC metadata document at
# {WORKOS_API_URL}/user_management/{WORKOS_CLIENT_ID}/.well-known/openid-configuration
# on the first token verification, and cached for the process lifetime. That
# document is the only authority on the issuer — WorkOS scopes `iss` to the
# *environment's* client id, which is not WORKOS_CLIENT_ID when the app is a
# non-default AuthKit application.

# WorkOS API origin. Defaults to https://api.workos.com.
# WORKOS_API_URL=

# Full JWKS URL. Overrides the discovered `jwks_uri`. Set only for a stand-in.
# WORKOS_JWKS_URL=

# Expected `iss` claim on access tokens. Overrides the discovered `issuer`. Set
# only for a custom auth domain or a stand-in that serves no metadata document.
# WORKOS_ISSUER=
