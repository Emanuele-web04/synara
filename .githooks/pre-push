#!/bin/sh
# Runs the same format and lint checks as CI's static lane before a push.
# Installed by `bun install` (scripts/install-git-hooks.ts); see CONTRIBUTING.md.
# Skip once with `git push --no-verify`.

# Nothing to check when every pushed ref is a deletion (all-zero local object).
updates=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  case "$local_oid" in
    *[!0]*) updates=1 ;;
  esac
done
[ "$updates" -eq 1 ] || exit 0

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is not on PATH; skipping fmt:check and lint (CI still runs them)." >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: bun run fmt:check && bun run lint (skip with git push --no-verify)" >&2
if bun run fmt:check && bun run lint; then
  exit 0
fi
echo "pre-push: fix the issues above (bun run fmt formats files), or push with --no-verify." >&2
exit 1
