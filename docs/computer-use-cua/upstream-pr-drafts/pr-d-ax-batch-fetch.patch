+// ── Batched attribute reads ──────────────────────────────────────────────────
+
+// The `kCFNull` singleton — the second marker form a batch slot can hold
+// for an unsupported/unreadable attribute (the first being an AXValue of
+// type `kAXValueAXErrorType`). Pointer equality is the documented check.
+#[link(name = "CoreFoundation", kind = "framework")]
+extern "C" {
+    static kCFNull: CFTypeRef;
+}
+
+/// Attribute names fetched per element in a single
+/// `AXUIElementCopyMultipleAttributeValues` IPC call. The slot indices in
+/// `copy_element_attrs` must match this order.
+const ELEMENT_BATCH_ATTRS: &[&str] = &[
+    "AXRole",             // 0
+    "AXChildren",         // 1
+    "AXTitle",            // 2
+    "AXValue",            // 3
+    "AXPlaceholderValue", // 4
+    "AXDescription",      // 5
+    "AXIdentifier",       // 6
+    "AXHelp",             // 7
+    "AXActionNames",      // 8
+    "AXEnabled",          // 9
+    "AXValueDescription", // 10
+    "AXMinValue",         // 11
+    "AXMaxValue",         // 12
+    "AXSelected",         // 13
+    "AXPosition",         // 14
+    "AXSize",             // 15
+];
+
+/// One element's attribute values, decoded from a single
+/// `AXUIElementCopyMultipleAttributeValues` round-trip. Failed or
+/// unsupported attributes decode to `None`/empty — the same result the
+/// single-attribute `copy_*` helpers produce for a failed fetch.
+///
+/// `children` holds retained `AXUIElementRef`s under the same ownership
+/// contract as [`copy_children`]: the caller must `CFRelease` each one
+/// after use. `action_names` is `None` when the element does not serve
+/// `AXActionNames` through the attribute API (most AppKit elements don't),
+/// in which case the caller should fall back to [`copy_action_names`].
+#[derive(Default)]
+pub struct ElementAttrs {
+    pub role: Option<String>,
+    pub title: Option<String>,
+    pub value: Option<StringishAttrValue>,
+    pub placeholder_value: Option<String>,
+    pub description: Option<String>,
+    pub identifier: Option<String>,
+    pub help: Option<String>,
+    pub action_names: Option<Vec<String>>,
+    pub enabled: Option<bool>,
+    pub value_description: Option<String>,
+    pub min_value: Option<f64>,
+    pub max_value: Option<f64>,
+    pub selected: Option<bool>,
+    /// `[x, y, width, height]` — only when both `AXPosition` and `AXSize`
+    /// decoded and the size is at least 1×1, matching the acceptance test
+    /// in [`element_screen_rect`].
+    pub frame: Option<[f64; 4]>,
+    pub children: Vec<AXUIElementRef>,
+}
+
+/// Fetch every attribute the AX tree walker reads for one element in a
+/// single IPC call.
+///
+/// When the batch call itself fails the returned struct is all defaults —
+/// equivalent to every individual read failing (unknown role, no children,
+/// no content) — so a dead or unresponsive element degrades the way the
+/// per-attribute path already does instead of aborting the walk.
+///
+/// # Safety
+///
+/// `element` must be a valid, live `AXUIElementRef` for the duration of the
+/// call. The caller must `CFRelease` every element in the returned
+/// `children` vec after use.
+pub unsafe fn copy_element_attrs(element: AXUIElementRef) -> ElementAttrs {
+    let names: Vec<CFStr> = ELEMENT_BATCH_ATTRS.iter().map(|n| CFStr::new(n)).collect();
+    let attr_array = CFArray::from_CFTypes(&names);
+    let mut values: CFArrayRef = std::ptr::null_mut();
+    let err = AXUIElementCopyMultipleAttributeValues(
+        element,
+        attr_array.as_concrete_TypeRef(),
+        // Do NOT pass kAXCopyMultipleAttributeOptionStopOnError — fetching
+        // must continue past attributes the element doesn't support.
+        0,
+        &mut values,
+    );
+    if err != kAXErrorSuccess || values.is_null() {
+        if !values.is_null() {
+            CFRelease(values as CFTypeRef);
+        }
+        return ElementAttrs::default();
+    }
+    let slots = CFArray::<CFTypeRef>::wrap_under_create_rule(values);
+    ElementAttrs {
+        role: batch_slot(&slots, 0).and_then(|v| slot_string(v)),
+        children: batch_slot(&slots, 1).map_or_else(Vec::new, |v| slot_children(v)),
+        title: batch_slot(&slots, 2).and_then(|v| slot_string(v)),
+        value: batch_slot(&slots, 3).and_then(|v| coerce_stringish_value(v)),
+        placeholder_value: batch_slot(&slots, 4).and_then(|v| slot_string(v)),
+        description: batch_slot(&slots, 5).and_then(|v| slot_string(v)),
+        identifier: batch_slot(&slots, 6).and_then(|v| slot_string(v)),
+        help: batch_slot(&slots, 7).and_then(|v| slot_string(v)),
+        action_names: batch_slot(&slots, 8).and_then(|v| slot_string_array(v)),
+        enabled: batch_slot(&slots, 9).and_then(|v| slot_bool(v)),
+        value_description: batch_slot(&slots, 10).and_then(|v| slot_string(v)),
+        min_value: batch_slot(&slots, 11).and_then(|v| slot_number(v)),
+        max_value: batch_slot(&slots, 12).and_then(|v| slot_number(v)),
+        selected: batch_slot(&slots, 13).and_then(|v| slot_bool(v)),
+        frame: slot_rect(batch_slot(&slots, 14), batch_slot(&slots, 15)),
+    }
+}
+
+/// The borrowed value at batch slot `index`, or `None` for out-of-range
+/// slots and error markers. The batch API places an AXValue of type
+/// `kAXValueAXErrorType` (wrapping that attribute's `AXError`) or the
+/// `kCFNull` singleton in slots it could not fill; every slot decoder
+/// below also type-checks its input, so a marker would map to `None`
+/// either way — filtering here just keeps that contract explicit.
+unsafe fn batch_slot(values: &CFArray<CFTypeRef>, index: usize) -> Option<CFTypeRef> {
+    let value = *values.get(index as _)?;
+    if value == kCFNull {
+        return None;
+    }
+    if core_foundation::base::CFGetTypeID(value) == AXValueGetTypeID()
+        && AXValueGetType(value as AXValueRef) == kAXValueAXErrorType
+    {
+        return None;
+    }
+    Some(value)
+}
+
+/// Decode a borrowed `CFString` slot; `None` for any other type.
+unsafe fn slot_string(value: CFTypeRef) -> Option<String> {
+    if core_foundation::base::CFGetTypeID(value) != CFStr::type_id() {
+        return None;
+    }
+    Some(CFStr::wrap_under_get_rule(value as _).to_string())
+}
+
+/// Decode a borrowed `CFNumber` slot; `None` for any other type.
+unsafe fn slot_number(value: CFTypeRef) -> Option<f64> {
+    use core_foundation::number::CFNumber;
+    if core_foundation::base::CFGetTypeID(value) != CFNumber::type_id() {
+        return None;
+    }
+    CFNumber::wrap_under_get_rule(value as _).to_f64()
+}
+
+/// Decode a borrowed `CFBoolean`/`CFNumber` slot — same coercion as
+/// [`copy_bool_attr`] (some apps report 0/1 numbers instead of booleans).
+unsafe fn slot_bool(value: CFTypeRef) -> Option<bool> {
+    use core_foundation::boolean::CFBoolean;
+    use core_foundation::number::CFNumber;
+    let type_id = core_foundation::base::CFGetTypeID(value);
+    if type_id == CFBoolean::type_id() {
+        return Some(CFBoolean::wrap_under_get_rule(value as _).into());
+    }
+    if type_id == CFNumber::type_id() {
+        return CFNumber::wrap_under_get_rule(value as _)
+            .to_f64()
+            .map(|f| f != 0.0);
+    }
+    None
+}
+
+/// Decode a borrowed `CFArray` of `CFString` slot (e.g. `AXActionNames`);
+/// `None` when the slot isn't an array.
+unsafe fn slot_string_array(value: CFTypeRef) -> Option<Vec<String>> {
+    if core_foundation::base::CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        return None;
+    }
+    let arr = CFArray::<CFStr>::wrap_under_get_rule(value as _);
+    Some(
+        (0..arr.len())
+            .filter_map(|i| arr.get(i).map(|s| s.to_string()))
+            .collect(),
+    )
+}
+
+/// Decode a borrowed `AXChildren` slot. Each element ref is retained —
+/// same ownership contract as [`copy_children`].
+unsafe fn slot_children(value: CFTypeRef) -> Vec<AXUIElementRef> {
+    if core_foundation::base::CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        return vec![];
+    }
+    let arr = CFArray::<CFTypeRef>::wrap_under_get_rule(value as _);
+    let ax_type_id = AXUIElementGetTypeID();
+    (0..arr.len())
+        .filter_map(|i| {
+            let item = *arr.get(i)?;
+            if core_foundation::base::CFGetTypeID(item) == ax_type_id {
+                // Retain so we own it — caller is responsible for releasing.
+                CFRetain(item);
+                Some(item as AXUIElementRef)
+            } else {
+                None
+            }
+        })
+        .collect()
+}
+
+/// Decode `AXPosition` + `AXSize` slots into `[x, y, width, height]` —
+/// the same decode and ≥1×1 size acceptance test as [`element_screen_rect`].
+unsafe fn slot_rect(position: Option<CFTypeRef>, size: Option<CFTypeRef>) -> Option<[f64; 4]> {
+    let position = position?;
+    if core_foundation::base::CFGetTypeID(position) != AXValueGetTypeID() {
+        return None;
+    }
+    let mut pos = CGPointValue { x: 0.0, y: 0.0 };
+    if !AXValueGetValue(
+        position as AXValueRef,
+        kAXValueCGPointType,
+        &mut pos as *mut _ as *mut c_void,
+    ) {
+        return None;
+    }
+    let size = size?;
+    if core_foundation::base::CFGetTypeID(size) != AXValueGetTypeID() {
+        return None;
+    }
+    let mut sz = CGSizeValue {
+        width: 0.0,
+        height: 0.0,
+    };
+    if !AXValueGetValue(
+        size as AXValueRef,
+        kAXValueCGSizeType,
+        &mut sz as *mut _ as *mut c_void,
+    ) || sz.width < 1.0
+        || sz.height < 1.0
+    {
+        return None;
+    }
+    Some([pos.x, pos.y, sz.width, sz.height])
+}
