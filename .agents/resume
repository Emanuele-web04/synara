#!/usr/bin/env bash
# Orb resume for Synara.
#
# Amp runs this after activation and on every wake. It must finish in seconds, stay
# idempotent, and never install anything: that is .agents/setup's job.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [ ! -d node_modules ] || [ ! -d "$HOME/.local/share/mise/shims" ]; then
  printf 'synara: orb environment is incomplete; run .agents/setup before building or testing\n' >&2
fi

# Dev servers are supervised and normally come back on their own; a long pause can
# leave one down, and ensure restarts it without starting a duplicate.
if [ -f .amp/services.yaml ] && command -v amp >/dev/null 2>&1; then
  amp orb services ensure >/dev/null 2>&1 ||
    printf 'synara: dev services are not running; run `amp orb services ensure` to see why\n' >&2
fi
