{
  "name": "@synara/contracts",
  "version": "1.5.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./hostUsage": {
      "types": "./src/hostUsage.ts",
      "import": "./src/hostUsage.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./uiLocale": {
      "types": "./src/uiLocale.ts",
      "import": "./src/uiLocale.ts"
    },
    "./productAnalytics": {
      "types": "./src/productAnalytics.ts",
      "import": "./src/productAnalytics.ts"
    },
    "./reliability": {
      "types": "./src/reliability.ts",
      "import": "./src/reliability.ts"
    },
    "./composerSlashCommands": {
      "types": "./src/composerSlashCommands.ts",
      "import": "./src/composerSlashCommands.ts"
    }
  },
  "scripts": {
    "dev": "tsdown src/index.ts --format cjs --watch --clean",
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:native": "bun run typecheck",
    "typecheck:legacy": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
